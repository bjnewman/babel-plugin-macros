{
  "name": "babel-plugin-macros",
  "version": "0.0.0-semantically-released",
  "description": "Allows you to build compile-time libraries",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test src/__tests__/*.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run format:check && npm run build && npm run test",
    "prepare": "husky"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "babel-plugin",
    "macros",
    "macro",
    "babel-macro",
    "babel-plugin-macro",
    "babel-macros",
    "babel-plugin-macros"
  ],
  "author": "Kent C. Dodds <me@kentcdodds.com> (https://kentcdodds.com)",
  "license": "MIT",
  "dependencies": {
    "lilconfig": "^3.1.3",
    "resolve": "^1.19.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/types": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.3.0",
    "@types/resolve": "^1.20.6",
    "babel-plugin-tester": "^12.0.0",
    "c8": "^10.1.3",
    "codegen.macro": "^4.1.0",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "ms.macro": "^2.0.0",
    "prettier": "^3.8.1",
    "preval.macro": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kentcdodds/babel-plugin-macros"
  },
  "bugs": {
    "url": "https://github.com/kentcdodds/babel-plugin-macros/issues"
  },
  "homepage": "https://github.com/kentcdodds/babel-plugin-macros#readme",
  "lint-staged": {
    "*.{js,ts}": "eslint --fix",
    "*.{js,ts,json,yaml,yml,md}": "prettier --write"
  },
  "engines": {
    "node": ">=22"
  }
}
